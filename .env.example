# Copy to .env for local secrets. Never commit real values.
# npm run dev turns on the fictional demonstration when SPEARPOINT_DEMO is unset.

APP_ORIGIN=http://127.0.0.1:3000
# Set to false on a machine that should use the real database instead of the demo.
SPEARPOINT_DEMO=true

# Staging basic auth. Required on private deployments. Not used by the local demo.
STAGING_USER=
STAGING_PASSWORD=

# Supabase. The demo runs without these. Production must set both, and the URL must be the project you migrated.
SUPABASE_URL=https://pcezdsdhmjxpjakxtdhz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_HMAC_KEY=

# RecruitCRM. Leave blank to show a labelled fictional result set in the team workspace.
RECRUIT_CRM_ENABLED=false
RECRUIT_CRM_API_KEY=
# Notes are written to RecruitCRM only when this is true AND a recruiter confirms the note.
# The partner desk can plan a two-way stage sync, with RecruitCRM winning conflicts, but it does not call the API.
RECRUIT_CRM_WRITE=false

# Partner outreach is sent only after an explicit confirm, and only when the partner's address equals this verified Resend sender.
PARTNER_OUTREACH_FROM=

# Licensed sourcing. Stubs until a contract is in place. Do not add a LinkedIn scraper.
ROCKETREACH_API_KEY=
PEOPLE_DATA_LABS_API_KEY=
CORESIGNAL_API_KEY=

# Model gateway. Client brief structuring and profile search use google/gemini-2.5-flash when this is set, and a deterministic parser when it is not.
AI_GATEWAY_API_KEY=

# Weekly portal calls. false stores a reminder and the HubSpot link. true asks for a HubSpot Meetings booking. That API is not connected, so the portal still shows the reminder.
HUBSPOT_MEETINGS_AUTOBOOK=false

# Daily retention. 20+ random characters. Vercel Cron sends it as Authorization: Bearer.
CRON_SECRET=

# 32-byte key, base64 or hex. Encrypts candidate identity. Required before any identity row is written.
CANDIDATE_IDENTITY_KEY=

# Owner signup alerts. Leave RESEND_API_KEY empty to skip email without affecting signup.
OWNER_ALERT_EMAIL=sam@spearpointsearch.com
ALERT_FROM_EMAIL=alerts@your-verified-domain.com
RESEND_API_KEY=

# Optional. Leave false until the founder authorises HubSpot contact creation.
HUBSPOT_SYNC_AUTHORIZED=false
HUBSPOT_PRIVATE_APP_TOKEN=
RETENTION_JOB_CONFIRMED=false
